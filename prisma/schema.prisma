// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  price       Int
  category    String?
  supplierId  Int?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  wishlists   Wishlist[]
  reviews     Review[]
  createdAt   DateTime         @default(now())
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  size       String // S, M, L, XL
  color      String? // Opsional: Hitam, Merah, dll.
  stock      Int
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  restocks   Restock[]
  orderItems OrderItem[]
}

enum Role {
  OWNER
  ADMIN
  KASIR
  PACKAGING
  USER
}

model User {
  id              Int        @id @default(autoincrement())
  email           String     @unique
  password        String
  nama            String
  foto            String?
  role            Role       @default(USER)
  orders          Order[]    @relation("CustomerOrders")
  kasirOrders     Order[]    @relation("KasirOrders")
  packagingOrders Order[]    @relation("PackagingOrders")
  wishlists       Wishlist[]
  reviews         Review[]
  createdAt       DateTime   @default(now())
}

model Supplier {
  id         Int       @id @default(autoincrement())
  nama       String
  no_telepon String
  alamat     String?
  products   Product[]
  restocks   Restock[]
  createdAt  DateTime  @default(now())
}

enum OrderStatus {
  DIPROSES
  DIKEMAS
  DIKIRIM
  SELESAI
}

enum OrderType {
  ONLINE
  OFFLINE
}

enum PaymentMethod {
  CASH
  QRIS
  MIDTRANS
}

enum PaymentStatus {
  MENUNGGU
  BERHASIL
  GAGAL
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int?
  user              User?       @relation("CustomerOrders", fields: [userId], references: [id])
  kasirId           Int?
  kasir             User?       @relation("KasirOrders", fields: [kasirId], references: [id])
  packagingId       Int?
  packagingStaff    User?       @relation("PackagingOrders", fields: [packagingId], references: [id])
  total_harga       Int
  ongkos_kirim      Int?
  status            OrderStatus @default(DIPROSES)
  jenis             OrderType
  alamat_pengiriman String?
  catatan           String?
  ekspedisi         String?
  resi              String?
  items             OrderItem[]
  payment           Payment?
  reviews           Review[]
  createdAt         DateTime    @default(now())
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId Int
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  jumlah           Int
  harga_satuan     Int
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int           @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  metode_pembayaran PaymentMethod
  status_pembayaran PaymentStatus @default(MENUNGGU)
  midtrans_token    String?
  createdAt         DateTime      @default(now())
}

model Restock {
  id               Int            @id @default(autoincrement())
  productVariantId Int
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  supplierId       Int?
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  jumlah           Int
  createdAt        DateTime       @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int // 1 sampai 5
  komentar  String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, orderId])
}

model ResetPasswordToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
