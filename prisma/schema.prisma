// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 Int              @id @default(autoincrement())
  sku                String?          @unique
  name               String
  description        String?
  descriptionImageUrl String?
  price              Int
  promoPrice         Int?
  categoryId  Int?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId  Int?
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  wishlists   Wishlist[]
  reviews     Review[]
  weight      Int              @default(500)
  createdAt   DateTime         @default(now())
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  size       String // S, M, L, XL
  color      String? // Opsional: Hitam, Merah, dll.
  stock      Int
  productId  Int
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  restocks   Restock[]
  orderItems OrderItem[]
  cartItems  CartItem[]
}

enum Role {
  OWNER
  ADMIN
  KASIR
  PACKAGING
  USER
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  password        String
  nama            String
  foto            String?
  no_telepon      String           @default("-")
  role            Role             @default(USER)
  orders          Order[]          @relation("CustomerOrders")
  kasirOrders     Order[]          @relation("KasirOrders")
  packagingOrders Order[]          @relation("PackagingOrders")
  wishlists       Wishlist[]
  reviews         Review[]
  addresses       Address[]
  cart            Cart?
  notifications   Notification[]
  shifts          CashierShift[]   @relation("KasirShifts")
  createdAt       DateTime         @default(now())
}

model Supplier {
  id         Int       @id @default(autoincrement())
  nama       String
  no_telepon String
  alamat     String?
  products   Product[]
  restocks   Restock[]
  createdAt  DateTime  @default(now())
}

enum OrderStatus {
  DIPROSES
  DIKEMAS
  DIKIRIM
  SELESAI
  DIKEMBALIKAN
}

enum OrderType {
  ONLINE
  OFFLINE
}

enum PaymentMethod {
  CASH
  QRIS
  MIDTRANS
}

enum PaymentStatus {
  MENUNGGU
  BERHASIL
  GAGAL
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int?
  user              User?       @relation("CustomerOrders", fields: [userId], references: [id])
  kasirId           Int?
  kasir             User?       @relation("KasirOrders", fields: [kasirId], references: [id])
  packagingId       Int?
  packagingStaff    User?       @relation("PackagingOrders", fields: [packagingId], references: [id])
  total_harga       Int
  ongkos_kirim      Int?
  status            OrderStatus @default(DIPROSES)
  jenis             OrderType
  alamat_pengiriman String?
  catatan           String?
  ekspedisi         String?
  resi              String?
  items             OrderItem[]
  payment           Payment?
  reviews           Review[]
  returnRequest     ReturnRequest?
  createdAt         DateTime    @default(now())
  dikemasAt         DateTime?
  dikirimAt         DateTime?
  selesaiAt         DateTime?
}

model OrderItem {
  id               Int            @id @default(autoincrement())
  orderId          Int
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId Int?
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  jumlah           Int
  harga_satuan     Int
}

model Payment {
  id                Int           @id @default(autoincrement())
  orderId           Int           @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  metode_pembayaran PaymentMethod
  status_pembayaran PaymentStatus @default(MENUNGGU)
  midtrans_token    String?
  midtrans_order_id String?
  midtrans_payment_type String?
  createdAt         DateTime      @default(now())
}

enum RestockType {
  MASUK
  KELUAR
}

model Restock {
  id               Int            @id @default(autoincrement())
  productVariantId Int
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  supplierId       Int?
  supplier         Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tipe             RestockType    @default(MASUK)
  jumlah           Int
  catatan          String?
  createdAt        DateTime       @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Review {
  id        Int           @id @default(autoincrement())
  userId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   Int
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int           // 1 sampai 5
  komentar  String?
  images    ReviewImage[]
  createdAt DateTime      @default(now())

  @@unique([userId, productId, orderId])
}

model ResetPasswordToken {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Manajemen Alamat Pelanggan ─────────────────────────────────────────────────

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String   // "Rumah", "Kantor", dll.
  penerima   String
  no_telepon String
  alamat     String
  kota       String
  kode_pos   String
  provinceId Int?
  cityId     Int?
  districtId Int?
  provinsi   String?
  kecamatan  String?
  is_utama   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ─── Manajemen Pengajuan Retur ──────────────────────────────────────────────────

model ReturnRequest {
  id         Int           @id @default(autoincrement())
  orderId    Int           @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  alasan     String
  keterangan String?
  bukti_url  String?       // Legacy single photo (kept for backward compat)
  resi       String?       // Nomor resi pengiriman retur dari pelanggan
  status     String        @default("MENUNGGU") // MENUNGGU, DISETUJUI, DIKIRIM, SELESAI, DITOLAK
  images     ReturnImage[]
  createdAt  DateTime      @default(now())
}

// ─── Foto Bukti Retur ───────────────────────────────────────────────────────────

model ReturnImage {
  id              Int           @id @default(autoincrement())
  url             String
  returnRequestId Int
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
}

// ─── Foto Ulasan ────────────────────────────────────────────────────────────────

model ReviewImage {
  id       Int    @id @default(autoincrement())
  url      String
  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

// ─── Notifikasi Sederhana ───────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  judul     String
  pesan     String
  is_read   Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ─── Banner / CMS Halaman Depan ─────────────────────────────────────────────────

model Banner {
  id        Int      @id @default(autoincrement())
  judul     String
  gambar    String
  link      String?
  urutan    Int      @default(0)
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─── Promo & Voucher ────────────────────────────────────────────────────────────

model Voucher {
  id               Int      @id @default(autoincrement())
  kode             String   @unique
  nama             String
  tipe_diskon      String   // "PERSENTASE" atau "NOMINAL"
  nilai_diskon     Int      // misal 10 (10%) atau 50000 (Rp50.000)
  min_pembelian    Int?
  max_diskon       Int?
  kuota            Int      @default(0)
  terpakai         Int      @default(0)
  tanggal_mulai    DateTime
  tanggal_berakhir DateTime
  aktif            Boolean  @default(true)
  createdAt        DateTime @default(now())
}

// ─── Kategori Produk ────────────────────────────────────────────────────────────

model Category {
  id        Int       @id @default(autoincrement())
  nama      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

// ─── Manajemen Shift Kasir ──────────────────────────────────────────────────────

model CashierShift {
  id          Int        @id @default(autoincrement())
  kasirId     Int
  kasir       User       @relation("KasirShifts", fields: [kasirId], references: [id])
  modal_awal  Int
  total_cash  Int        @default(0)
  total_qris  Int        @default(0)
  pengeluaran Int        @default(0)
  modal_akhir Int?
  catatan     String?
  mulai       DateTime   @default(now())
  selesai     DateTime?
  expenses    PettyCash[]
}

// ─── Pengeluaran Toko (Petty Cash) ──────────────────────────────────────────────

model PettyCash {
  id         Int          @id @default(autoincrement())
  shiftId    Int
  shift      CashierShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  jumlah     Int
  keterangan String
  createdAt  DateTime     @default(now())
}

// ─── Konfigurasi Global Toko ────────────────────────────────────────────────────

model GlobalSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

// ─── Keranjang Belanja ──────────────────────────────────────────────────────────

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id               Int            @id @default(autoincrement())
  cartId           Int
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId Int
  variant          ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  quantity         Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, productVariantId])
}
